{
	"id": "breinhap",
	"name": "Breinhap beheer",
	"version": "0.2.19",
	"platform": ">=0.1 <1",
	"owner": "ASafariM Digital",
	"domains": {
		"primary": "management.breinhap.com"
	},
	"runtime": {
		"image": "ghcr.io/alisafari-it/breinhap",
		"port": 8080,
		"health": {
			"live": "/healthz",
			"ready": "/readyz"
		},
		"resources": {
			"memory": "128m",
			"cpus": 0.25
		}
	},
	"database": {
		"engine": "none"
	},
	"auth": {
		"client": "oidc",
		"publicPaths": [
			"/healthz",
			"/readyz",
			"/.well-known/asafarim-app.json",
			"/login",
			"/register",
			"/aanmelden",
			"/login/code",
			"/login/opnieuw",
			"/auth/start",
			"/auth/callback",
			"/auth/backchannel-logout",
			"/auth/invite-link",
			"/session.js",
			"/editor.js",
			"/theme.js",
			"/styles.css",
			"/theme.css",
			"/logo.svg",
			"/locale-selector.js",
			"/locale-selector.css"
		]
	},
	"permissions": [
		{
			"key": "breinhap.management.access",
			"description": "Open the adult management shell; grants no student or content scope"
		},
		{
			"key": "breinhap.student.access",
			"description": "Student role; never permits management access"
		},
		{
			"key": "breinhap.memberships.manage",
			"description": "Invite and revoke adult pilot members in the configured workspace; cannot grant ASafariM roles"
		}
	],
	"roles": [
		{
			"key": "breinhap.admin",
			"grants": ["breinhap.management.access", "breinhap.memberships.manage"]
		},
		{
			"key": "breinhap.parent",
			"grants": ["breinhap.management.access"]
		},
		{
			"key": "breinhap.tutor",
			"grants": ["breinhap.management.access"]
		},
		{
			"key": "breinhap.teacher",
			"grants": ["breinhap.management.access"]
		},
		{
			"key": "breinhap.student",
			"grants": ["breinhap.student.access"]
		}
	],
	"secrets": [
		"ASAFARIM_REGISTRY_CREDENTIAL",
		"REDIS_URL",
		"SESSION_ENCRYPTION_KEY"
	],
	"ui": {
		"glyph": "BH",
		"color": "#23456b",
		"nav": [
			{
				"label": "Overzicht",
				"href": "/"
			}
		],
		"status": "active",
		"launcher": {
			"description": "Adult workspace for parents, tutors and teachers.",
			"meta": "management.breinhap.com",
			"access": "authenticated",
			"requiresAccountToUse": true,
			"order": 70
		}
	}
}
